# -----------------------------------------------------------------------------
# VeriSnap environment configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase Dashboard -> Project Settings -> API
#
# SECURITY NOTE:
# Only the ANON (public) key belongs in a mobile app. It is designed to be
# shipped to clients and is safe to expose *because* every table is protected by
# Row Level Security (RLS). The `service_role` key must NEVER be placed here or
# anywhere in the app bundle — it bypasses RLS and would compromise all data.
#
# The `EXPO_PUBLIC_` prefix tells Expo to inline these values into the JS bundle
# at build time. Never put a true secret behind this prefix.
# -----------------------------------------------------------------------------

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-SUPABASE-ANON-KEY
